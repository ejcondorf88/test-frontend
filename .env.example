# Variables de entorno para el Frontend
# Copia este archivo como .env y ajusta los valores

# ============================================
# Desarrollo (npm run dev)
# ============================================

# Credit Card Service - puerto 9000 (según documentación)
VITE_CREDIT_CARD_URL=http://localhost:9000/api/v1

# ============================================
# Producción (Docker)
# ============================================
# En producción, el frontend se serve desde nginx
# y las APIs se acceden a través de los paths:
#   /credit-card-api/v1/...
# No necesitas configurar nada extra